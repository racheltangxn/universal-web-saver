# --- Personal webhook auth ---
# Any random string; the Android HTTP Shortcut must send this back as X-API-Key.
SECRET_WEBHOOK_KEY=replace-with-a-long-random-string

# --- Apify (Instagram / TikTok / LinkedIn scraping) ---
APIFY_API_TOKEN=apify_api_xxxxxxxxxxxxxxxxxxxxxxxx
# Optional overrides — defaults shown are reasonable public actors.
# APIFY_INSTAGRAM_ACTOR=apify/instagram-scraper
# APIFY_TIKTOK_ACTOR=clockworks/tiktok-scraper
# APIFY_LINKEDIN_ACTOR=apify/linkedin-post-scraper

# --- Gemini (tagging engine) ---
GEMINI_API_KEY=your-google-ai-studio-api-key
# Optional override; defaults to gemini-flash-latest (a rolling alias to the
# current-gen Flash model — gemini-1.5-flash/2.5-flash are retired for new keys).
# GEMINI_MODEL=gemini-flash-latest

# --- Notion ---
NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_DATABASE_ID=your-notion-database-id
