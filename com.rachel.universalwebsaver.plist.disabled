<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.rachel.universalwebsaver</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/racheltang/universal-web-saver/.venv/bin/uvicorn</string>
        <string>main:app</string>
        <string>--host</string>
        <string>0.0.0.0</string>
        <string>--port</string>
        <string>8000</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/racheltang/universal-web-saver</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/racheltang/universal-web-saver/service.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/racheltang/universal-web-saver/service.log</string>
</dict>
</plist>
